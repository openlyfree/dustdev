# syntax=docker/dockerfile:1

FROM docker.io/library/golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /frontbackend .

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=build /frontbackend /usr/local/bin/frontbackend

ENV PORT=8081 \
	GIN_MODE=release
EXPOSE 8081

ENTRYPOINT ["/usr/local/bin/frontbackend"]
