{
	email {$ACME_EMAIL}
}

# ── Apex: landing page, dashboard SPA, and the platform API ──────────────
{$BASE_DOMAIN} {
	root * /srv/frontend
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy frontbackend:8081
	}

	handle {
		# SPA fallback: unknown paths render the client-side app
		try_files {path} /200.html
		file_server
	}
}

www.{$BASE_DOMAIN} {
	redir https://{$BASE_DOMAIN}{uri} permanent
}

# ── Wildcard: one devcontainer per subdomain ─────────────────────────────
*.{$BASE_DOMAIN} {
	tls {
		dns porkbun {
			api_key {$PORKBUN_API_KEY}
			api_secret_key {$PORKBUN_SECRET_KEY}
		}
	}

	# Capture the subdomain label into {re.subdomain.slug} (the project slug).
	# {host.labels.*} was removed from Caddy, so a named matcher is the way to
	# extract it.
	@subdomain header_regexp subdomain Host ^([a-z0-9-]+)\.{$BASE_DOMAIN}$

	# idehost has no auth of its own; gate every request (incl. the
	# terminal WebSocket upgrade) on a valid session + project ownership.
	forward_auth frontbackend:8081 {
		uri /api/authz
		copy_headers X-Forwarded-Host
	}

	# Container network aliases equal the project slug, so the subdomain label
	# is the dial address (resolved by podman's aardvark-dns). header_up sets
	# the Host the upstream sees; stopped containers 502.
	handle @subdomain {
		reverse_proxy {re.subdomain.1}:8080 {
			header_up Host {re.subdomain.1}
		}
	}
}
