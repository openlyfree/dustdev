# syntax=docker/dockerfile:1

# Caddy with the Porkbun DNS provider, required for the DNS-01 ACME challenge
# that issues the *.dustdev.app wildcard certificate.
FROM docker.io/library/caddy:2-builder AS builder

RUN xcaddy build \
	--with github.com/caddy-dns/porkbun

FROM docker.io/library/caddy:2

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
