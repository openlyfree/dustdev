[Unit]
Description=dustdev platform API (auth, projects, podman orchestration)
After=dustdev-network.service postgres.service

[Container]
ContainerName=frontbackend
Image=ghcr.io/openlyfree/dustdev-frontbackend:latest
Network=dustdev.network
EnvironmentFile=/etc/dustdev/dustdev.env
# Rootful podman socket: the API creates/starts/stops devcontainers on the host.
# Run as root and keep the container in the host's SELinux context so it can
# actually connect to the rootful socket (rootless/SELinux-confined containers
# get EACCES on connect even when the socket is 0666).
User=0
SecurityLabelDisable=true
Volume=/run/podman/podman.sock:/run/podman/podman.sock

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
