# Copy to /etc/dustdev/dustdev.env on the server and fill in real values.
# All three quadlet containers read this file; each picks the vars it needs.

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=dustdev
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=dustdev

# ── frontbackend ─────────────────────────────────────────────────────────
# Points at the postgres quadlet above by default; replace with a DigitalOcean
# Managed Database URL if you prefer (no other changes needed).
DATABASE_URL=postgres://dustdev:change-me-to-a-long-random-string@postgres:5432/dustdev
SESSION_SECRET=generate-with-openssl-rand-hex-32
BASE_DOMAIN=dustdev.app
URL_SCHEME=https
# The image the platform spawns for each project's IDE. Points at the mutable
# `production` tag CI publishes to GHCR; IDE containers use pull=always, so a
# project picks up the latest build the next time it starts. For a fork, either
# set GITHUB_REPOSITORY (owner/repo) in this file or override IDE_IMAGE here.
IDE_IMAGE=ghcr.io/ethan/code-az-idehost:production
PODMAN_SOCKET=/run/podman/podman.sock
PODMAN_NETWORK=dustdev
PORT=8081
# Quotas / container resources
MAX_PROJECTS_PER_USER=5
MAX_RUNNING_PER_USER=2
CONTAINER_MEMORY_MB=2048
CONTAINER_CPUS=2
SESSION_TTL_DAYS=30

# ── Caddy ────────────────────────────────────────────────────────────────
# Porkbun API credentials (https://porkbun.com/account/api) used for the
# DNS-01 challenge that issues the *.dustdev.app wildcard certificate.
PORKBUN_API_KEY=pk1_...
PORKBUN_SECRET_KEY=sk1_...
ACME_EMAIL=you@example.com
